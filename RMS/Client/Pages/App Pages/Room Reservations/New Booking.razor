    private void UpdateFilteredRooms()
    {
        roomBookingFilter = roomBookings.Where(rb => !string.IsNullOrEmpty(rb.RoomNo)).ToList();

        foreach (var roomBooking in roomBookings)
        {
            roomBooking.FilteredRooms = GetFilteredRooms(roomBooking).ToList();
        }
        StateHasChanged();
    }

    private IEnumerable<Room> GetFilteredRooms(RoomBooking roombook)
    {
        var selectedRoomNumbers = roomBookingFilter.Select(rb => rb.RoomNo).ToHashSet();

        if (Id > 0)
        {
            // For the case when Id > 0, include the current room and other available rooms
            return string.IsNullOrEmpty(roombook.RoomType)
                ? Enumerable.Empty<Room>()
                : rooms.Where(r =>
                    r.Category == roombook.RoomType &&
                    (r.RoomNumber == roombook.RoomNo || r.Status == RoomHallStatus.Available)
                );
        }
        else
        {
            // For the case when Id is 0, apply the filter on available rooms only
            return string.IsNullOrEmpty(roombook.RoomType)
                ? Enumerable.Empty<Room>()
                : rooms.Where(r =>
                    r.Category == roombook.RoomType &&
                    r.Status == RoomHallStatus.Available &&
                    (r.RoomNumber == roombook.RoomNo || !selectedRoomNumbers.Contains(r.RoomNumber))
                );
        }
    }


   

