    private void CalculateTotalCharge()
    {
        decimal totalBookingCharge = roomBookings.Sum(rb =>
        {
            var room = rooms.FirstOrDefault(r => r.RoomNumber == rb.RoomNo);
            return room?.Price ?? 0;
        });

        model.BillingDetails.BookingCharge = totalBookingCharge;

        // Recalculate the total charge including tax and service charge
        model.BillingDetails.TotalCharge = totalBookingCharge +
                                           (totalBookingCharge * model.BillingDetails.Tax / 100) +
                                           model.BillingDetails.ServiceCharge;
    }

    private void CalculateTotalCharges()
    {
        // Calculate the total booking charge from room bookings
        decimal totalBookingCharge = roomBookings.Sum(rb =>
        {
            var room = rooms.FirstOrDefault(r => r.RoomNumber == rb.RoomNo);
            return room?.Price ?? 0;
        });

        // Update the booking charge in billing details
        model.BillingDetails.BookingCharge = totalBookingCharge;

        // Calculate discount
        decimal discount = model.PaymentDetails.isDiscountInPercentage
            ? totalBookingCharge * model.PaymentDetails.DiscountRate / 100
            : model.PaymentDetails.DiscountAmount;

        // Calculate commission
        decimal commission = model.PaymentDetails.isCommissionInPercentage
            ? totalBookingCharge * model.PaymentDetails.CommissionRate / 100
            : model.PaymentDetails.CommissionAmount;

        // Calculate the total charge including tax, service charge, discount, and commission
        model.BillingDetails.TotalCharge = totalBookingCharge +
                                           (totalBookingCharge * model.BillingDetails.Tax / 100) +
                                           model.BillingDetails.ServiceCharge -
                                           discount -
                                           commission;
    }




    private void OnRoomNoChange(ChangeEventArgs e, RoomBooking roombook)
    {
        roombook.RoomNo = e.Value?.ToString();
        roombook.RoomPrice = 0;
        var room = rooms.FirstOrDefault(r => r.RoomNumber == roombook.RoomNo);
        if (room != null)
        {
            // Update the booking charge for this room
            roombook.RoomPrice = room.Price;
            CalculateTotalCharges();
        }
        UpdateFilteredRooms();
    }

    private void DeleteRoom(RoomBooking roombook)
    {
        roomBookings.Remove(roombook);
        // Recalculate the total charge after room removal
        CalculateTotalCharges();
        UpdateFilteredRooms();
    }

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value?.ToString()))
        {
            model.BillingDetails.Tax = Convert.ToDecimal(e.Value);
        }
        else
        {
            // If tax is cleared (empty string), set tax to 0
            model.BillingDetails.Tax = 0;
        }

        // Recalculate the total charge with the updated (or removed) tax
        CalculateTotalCharges();
    }


