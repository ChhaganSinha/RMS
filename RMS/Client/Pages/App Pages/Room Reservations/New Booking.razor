    public async Task OnSave()
    {
        process = true;
        alert?.Clear();
        message = string.Empty;
        MessageBody = "Thank you!";
        IsError = false;
        IsSuccess = false;
        show = true;
        TaskCompleted = false;
        message = "Please wait";

        try
        {
            // Check for duplicate room numbers
            var duplicateRooms = roomBookings
                .GroupBy(rb => rb.RoomNo)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key)
                .ToList();

            if (duplicateRooms.Any())
            {
                alert?.SetError($"Duplicate room numbers found: {string.Join(", ", duplicateRooms)}");
                return;
            }

            // Update room details in model
            model.RoomBookings = roomBookings.Select(rb => new RoomBookingDto
                {
                    RoomType = rb.RoomType,
                    RoomNo = rb.RoomNo,
                    RoomId = rooms.FirstOrDefault(x => x.RoomNumber == rb.RoomNo)?.Id ?? 0,
                    Adults = rb.Adults,
                    Children = rb.Children,
                    RoomPrice = rb.RoomPrice

                }).ToList();

            // Update customer information in model
            model.CustomerInfo = existingCustomers.Select(ec => new CustomerInfoDto
                {
                    Name = ec.FirstName,
                    MobileNo = ec.MobileNo,
                    Email = ec.Email
                }).ToList();

            var response = await client.UpsertReservationDetails(model);
            if (response.IsSuccess)
            {
                alert?.SetSuccess(response.Message);
                message = "Success";
                MessageBody = response.Message;
                model = new();
            }
            else
            {
                alert?.SetError(response.Message);
                MessageBody = response.Message;
                message = "Error!";
            }


            model = new ReservationDetailsDto
                {
                    PaymentDetails = new PaymentDetailsDto(),
                    BillingDetails = new BillingDetailsDto(),
                    CustomerInfo = new List<CustomerInfoDto>(),
                    RoomBookings = new List<RoomBookingDto>()
                };

            roomBookings = new List<RoomBooking>(); //reset room bboking table
            TaskCompleted = true;
        }
        catch (Exception ex)
        {
            IsError = true;
            message = "Error!";
            MessageBody = ex.Message;
            TaskCompleted = true;
        }

        process = false;
        rooms = await client.GetAllRoom();
        StateHasChanged();
    }


