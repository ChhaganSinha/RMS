@using GridShared
@using GridShared.Columns
@using GridShared.Utility
@using Microsoft.Extensions.Primitives
@using RMS.Client.Pages.GridComponent
@using RMS.Client.Shared.Popup
@using RMS.Client.Client
@inject AppClient client
@implements ICustomGridComponent<ReservationDetailsDto>
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime


<button class='btn btn-sm btn-success' style="border-radius:15px" @onclick="MyClickHandler" title="Print"><i class="fa fa-print"></i></button>

<PageDialog Title="@Title" Show="@show" ClosePageDialog="ResetForm">
    @if (show)
    {
        <section>
            <div class="container" style="font-family:monospace;">
                <div class="row justify-content-center m-0">
                    <div class="col-12 col-lg-12 col-xl-12 col-xxl-12">
                        <div id="billSection">
                            <div class="row gy-3 mb-3">
                                <div class="col-6">
                                    <h4 class="text-uppercase text-endx m-0">Reservation Invoice</h4>
                                </div>
                                @* Uncomment and replace the source with your logo image URL *@
                                <!-- <div class="col-6">
                                    <a class="d-block text-end" href="#!">
                                        <img src="/assets/images/logo.png" class="img-fluid" alt="Logo" width="100" height="44">
                                    </a>
                                </div> -->
                                <div class="col-12">
                                    <h4>From</h4>
                                    <address>
                                        <strong>Royal Heritage</strong><br>
                                        Hotel Street<br>
                                        Pilibhit City, UP, 262001<br>
                                        Phone: xxxxxxxxx<br>
                                        Email: info@royalheritagepilibhit.in
                                    </address>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12 col-sm-6 col-md-8">
                                    <h4>Bill To</h4>
                                    <address>
                                        <strong>@model.CustomerInfo.FirstOrDefault()?.Name</strong><br>
                                        <!-- Assuming customer's address -->
                                        @* 456 Oak Avenue<br> *@
                                        City, State, Zip Code<br>
                                        Phone: @model.CustomerInfo.FirstOrDefault()?.MobileNo<br>
                                        Email: @model.CustomerInfo.FirstOrDefault()?.Email
                                    </address>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <h4 class="row">
                                        <span style="font-size:14px;" class="col-6">Invoice #</span>
                                        <br />
                                        <span style="font-size:14px;" class="col-6 text-sm-end">@model.BookingReferenceNo</span>
                                    </h4>
                                    <div class="row">
                                        <span class="col-6">Date</span>
                                        <span class="col-6 text-sm-end">@DateTime.Now.ToString("MM/dd/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="text-uppercase">Qty</th>
                                                    <th scope="col" class="text-uppercase">Type</th>
                                                    <th scope="col" class="text-uppercase text-end">Room Number</th>
                                                    <th scope="col" class="text-uppercase text-end">Unit Price</th>
                                                </tr>
                                            </thead>
                                            <tbody class="table-group-divider">
                                                @foreach (var room in model.RoomBookings)
                                                {
                                                    <tr>
                                                        <th scope="row">@(++count)</th>
                                                        <td>@room.RoomType</td>
                                                        <td class="text-end">@room.RoomNo</td>
                                                        <td class="text-end">@room.RoomPrice</td>
                                                    </tr>
                                                }
                                                <tr>
                                                    <th scope="row" colspan="3" class="text-end">Subtotal</th>
                                                    <td class="text-end">@model.BillingDetails.BookingCharge.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-end">Tax</td>
                                                    <td class="text-end">
                                                        @((model.BillingDetails.Tax / 100).ToString("P2")) 
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-end">Service Charge</td>
                                                    <td class="text-end">@model.BillingDetails.ServiceCharge.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td>
                                                </tr>

                                                <!-- Discount details section -->
                                                <tr>
                                                    <td colspan="3" class="text-end">
                                                        Discount (@(model.PaymentDetails.isDiscountInPercentage ? $"{model.PaymentDetails.DiscountRate}% in Percentage" : $"₹{model.PaymentDetails.DiscountAmount} in Rupee"))
                                                    </td>
                                                    <td class="text-end">
                                                        -@((model.PaymentDetails.isDiscountInPercentage
                                                           ? model.BillingDetails.BookingCharge * model.PaymentDetails.DiscountRate / 100
                                                           : model.PaymentDetails.DiscountAmount).ToString("C", new System.Globalization.CultureInfo("en-IN")))
                                                    </td>
                                                </tr>

                                                <tr>
                                                    <th scope="row" colspan="3" class="text-uppercase text-end">Total</th>
                                                    <td class="text-end">@model.BillingDetails.TotalCharge.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-secondary mb-3" @onclick="ResetForm">Close</button>
                                <button type="button" class="btn btn-primary mb-3" @onclick="PrintInvoice">Print Invoice</button>
                                <button type="button" class="btn btn-warning mb-3" @onclick="DownloadPdf">Download PDF</button>
                                @* <button type="submit" class="btn btn-danger mb-3">Pay Now</button> *@
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</PageDialog>

@code {
    [Parameter]
    public ReservationDetailsDto Item { get; set; }

    [Parameter]
    public CGrid<ReservationDetailsDto> Grid { get; set; }

    [CascadingParameter]
    protected AlertModel? alert { get; set; }

    bool show = false;
    string Title = "Invoice";
    int count = 0;

    ReservationDetailsDto model = new();

    private async Task MyClickHandler(MouseEventArgs e)
    {
        alert?.Clear();
        show = true;
        model = await client.GetReservationDetailsDtoById(Item.Id);
    }


    private async Task PrintInvoice()
    {
        await JSRuntime.InvokeVoidAsync("printPDF", "billSection");
    }

    private async Task DownloadPdf()
    {
        var filename = $"{model.CustomerInfo.FirstOrDefault()?.Name}_invoice_{DateTime.Now.ToString()}.pdf"; // Define your filename
        await JSRuntime.InvokeVoidAsync("downloadPDF", "billSection", filename);
    }

    private void ResetForm()
    {
        model = new();
        show = false;
    }
}
